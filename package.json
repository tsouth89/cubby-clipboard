    "clsx": "^2.0.0",
    "date-fns": "^3.6.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^14.0.0",
    "sonner": "^2.0.8",
